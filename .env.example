# Compose reads this file automatically. Copy it to `.env` and fill in the
# values before running `docker compose up --build`.

# Required. At least 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SIGNING_KEY=

# Local database credentials. Change these for any shared environment.
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce-local

# Public browser URL of the API and the origin allowed by CORS.
NEXT_PUBLIC_API_URL=http://localhost:5250
APP_ORIGIN=http://localhost:3000

# Optional: enables HMAC-signed provisioning AND sign-in from Get Assist. Leave
# empty to keep `POST /api/v1/integrations/provision` and
# `POST /api/v1/integrations/sso/launch` disabled (503).
GETASSIST_PROVISIONING_SECRET=
GETASSIST_SIGNATURE_HEADER=X-GetAssist-Signature

# The Get Assist origins that may show Commerce inside a frame, comma
# separated (e.g. https://app.chithii.com). Used by both the API and the
# dashboard. Empty = no site may frame Commerce.
HOST_PLATFORM_ALLOWED_ORIGINS=
# Not used yet (kept for a future launch contract).
HOST_PLATFORM_LAUNCH_URL=

# First run only: create the demo company, user, products and orders.
SEED_DEMO_ACCOUNT=false
SEED_DEMO_EMAIL=admin@commerce.local
SEED_DEMO_PASSWORD=Admin123!
